+"""Tests for tags.normalize_tag."""
+
+import unittest
+
+from tags import normalize_tag
+
+
+class NormalizeTagTests(unittest.TestCase):
+    def test_lowercases_ascii(self):
+        self.assertEqual(normalize_tag("Hello World"), "hello-world")
+        self.assertEqual(normalize_tag("MiXeD CaSe"), "mixed-case")
+
+    def test_collapses_consecutive_spaces(self):
+        self.assertEqual(normalize_tag("a   b"), "a-b")
+        self.assertEqual(normalize_tag("a     b  c"), "a-b-c")
+
+    def test_tabs_collapse_to_single_hyphen(self):
+        self.assertEqual(normalize_tag("a\tb"), "a-b")
+        self.assertEqual(normalize_tag("a\t\tb"), "a-b")
+
+    def test_newlines_collapse_to_single_hyphen(self):
+        self.assertEqual(normalize_tag("a\nb"), "a-b")
+        self.assertEqual(normalize_tag("a\r\n\r\nb"), "a-b")
+
+    def test_mixed_whitespace_run_collapses_once(self):
+        self.assertEqual(normalize_tag("a \t\n\r b"), "a-b")
+
+    def test_strips_surrounding_whitespace(self):
+        self.assertEqual(normalize_tag("  hello  "), "hello")
+        self.assertEqual(normalize_tag("\t\nHello\r\n"), "hello")
+        self.assertEqual(normalize_tag("\u00a0Hello\u3000"), "hello")
+
+    def test_empty_input_raises(self):
+        with self.assertRaises(ValueError):
+            normalize_tag("")
+
+    def test_whitespace_only_input_raises(self):
+        for value in ("   ", "\t\n", " \r\n\t ", "\u00a0", "\u3000\u3000"):
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    normalize_tag(value)
+
+    def test_preserves_unicode_letters(self):
+        self.assertEqual(normalize_tag("Café  au Lait"), "café-au-lait")
+        self.assertEqual(normalize_tag("标签  测试"), "标签-测试")
+        self.assertEqual(normalize_tag("Москва 2024"), "москва-2024")
+
+    def test_does_not_normalize_unicode(self):
+        self.assertEqual(normalize_tag("Cafe\u0301"), "cafe\u0301")
+        self.assertNotEqual(normalize_tag("Cafe\u0301"), "café")
+
+    def test_preserves_punctuation_and_digits(self):
+        self.assertEqual(normalize_tag("a.b,c!d"), "a.b,c!d")
+        self.assertEqual(normalize_tag("Hello, World!"), "hello,-world!")
+        self.assertEqual(normalize_tag("v1.2_beta"), "v1.2_beta")
+
+    def test_strips_leading_and_trailing_hyphens(self):
+        self.assertEqual(normalize_tag("-a-"), "a")
+        self.assertEqual(normalize_tag("---a---b---"), "a---b")
+        self.assertEqual(normalize_tag("  --Hello--  "), "hello")
+
+    def test_hyphen_only_input_returns_empty_string(self):
+        self.assertEqual(normalize_tag("-"), "")
+        self.assertEqual(normalize_tag("----"), "")
+        self.assertEqual(normalize_tag("- -"), "")
+        self.assertEqual(normalize_tag("  -  "), "")
+
+    def test_internal_hyphens_are_kept(self):
+        self.assertEqual(normalize_tag("a - b"), "a---b")
+        self.assertEqual(normalize_tag("a-b c-d"), "a-b-c-d")
+
+    def test_unicode_whitespace_inside(self):
+        self.assertEqual(normalize_tag("a\u00a0b"), "a-b")
+        self.assertEqual(normalize_tag("a\u3000\u3000b"), "a-b")
+
+
+if __name__ == "__main__":
+    unittest.main()
